/* =========================================================
   5. 季節（長期）預報
   ========================================================= */
async function fetchSeasonalForecast(loc) {
  const cacheKey = `${loc.id}_seasonal`;
  if (seasonalCache[cacheKey]) return seasonalCache[cacheKey];

  try {
    const url = `https://seasonal-api.open-meteo.com/v1/seasonal`
      + `?latitude=${loc.lat}&longitude=${loc.lon}`
      + `&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum`
      + `&timezone=auto`
      + `&forecast_days=${SEASONAL_DAYS}`
      + `&models=ecmwf_ec46`;
    const data = await fetchJSON(url, 1);
    if (data.daily && Array.isArray(data.daily.time)) {
      seasonalCache[cacheKey] = data.daily;
      return data.daily;
    }
  } catch (err) {
    console.warn(`查詢 ${loc.name} 長期預報失敗`, err);
  }
  return null;
}

/* =========================================================
   6. 歷史平均值（過去三年同日）
   ========================================================= */
async function fetchHistoricalAverage(loc, dateStr) {
  const cacheKey = `${loc.id}_${dateStr}`;
  if (historicalCache[cacheKey]) return historicalCache[cacheKey];

  const targetYear = parseInt(dateStr.slice(0, 4), 10);
  const monthDay = dateStr.slice(5);
  const pastYears = [];
  for (let i = 1; i <= 3; i++) pastYears.push(`${targetYear - i}-${monthDay}`);

  const yearData = [];
  for (const pastDate of pastYears) {
    try {
      const url = `https://archive-api.open-meteo.com/v1/archive`
        + `?latitude=${loc.lat}&longitude=${loc.lon}`
        + `&start_date=${pastDate}&end_date=${pastDate}`
        + `&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,sunrise,sunset`
        + `&hourly=temperature_2m,precipitation,weather_code,wind_speed_10m`
        + `&timezone=auto`;
      const data = await fetchJSON(url, 1);
      if (data.daily && data.daily.time && data.daily.time.length > 0) {
        const slots = analyzeDaySlots(data.hourly, pastDate, false);
        yearData.push({
          date: pastDate,
          max: data.daily.temperature_2m_max[0],
          min: data.daily.temperature_2m_min[0],
          code: data.daily.weather_code[0],
          precipSum: data.daily.precipitation_sum?.[0] ?? 0,
          sunrise: data.daily.sunrise?.[0],
          sunset: data.daily.sunset?.[0],
          slots: slots
        });
      }
    } catch (err) {
      console.warn(`查詢 ${loc.name} ${pastDate} 歷史數據失敗`, err);
    }
  }

  if (yearData.length === 0) return null;

  const avgMax = Math.round(yearData.reduce((s, d) => s + d.max, 0) / yearData.length);
  const avgMin = Math.round(yearData.reduce((s, d) => s + d.min, 0) / yearData.length);
  const avgPrecip = Math.round((yearData.reduce((s, d) => s + d.precipSum, 0) / yearData.length) * 10) / 10;
  const latest = yearData[yearData.length - 1];

  const avgSlots = TIME_SLOTS.map((slot, si) => {
    const yearSlots = yearData.map(y => y.slots ? y.slots[si] : null).filter(Boolean);
    const avgScore = Math.round(yearSlots.reduce((s, sl) => s + sl.score, 0) / yearSlots.length);
    const reasons = new Set();
    yearSlots.forEach(sl => sl.reasons.forEach(r => reasons.add(r)));
    return { ...slot, score: avgScore, level: getLevel(avgScore), reasons: Array.from(reasons) };
  });

  const avg = {
    max: avgMax,
    min: avgMin,
    rain: avgPrecip,
    code: yearData[0].code,
    years: yearData.map(d => d.date),
    sampleCount: yearData.length,
    slots: avgSlots,
    sunrise: latest.sunrise,
    sunset: latest.sunset
  };

  historicalCache[cacheKey] = avg;
  return avg;
}

/* =========================================================
   7. 抓取資料（僅在頁面開啟或手動點擊時執行）
   ========================================================= */
let isFetching = false;

async function fetchAllWeather() {
  if (isFetching) return;
  isFetching = true;
  setLoading(true);
  setStatus('正在載入最新資料…', 'loading');

  // 手動重載時清空快取，確保取得最新資料
  Object.keys(historicalCache).forEach(k => delete historicalCache[k]);
  Object.keys(seasonalCache).forEach(k => delete seasonalCache[k]);

  const [forecastResults, seasonalResults] = await Promise.all([
    Promise.allSettled(
      locations.map(loc => {
        const url = 'https://api.open-meteo.com/v1/forecast'
          + `?latitude=${loc.lat}&longitude=${loc.lon}`
          + '&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset'
          + '&hourly=temperature_2m,precipitation,precipitation_probability,weather_code,wind_speed_10m'
          + '&timezone=auto'
          + `&forecast_days=${FORECAST_DAYS}`;
        return fetchJSON(url).then(data => ({
          id: loc.id,
          daily: data.daily,
          hourly: data.hourly
        }));
      })
    ),
    Promise.allSettled(
      locations.map(loc => fetchSeasonalForecast(loc).then(daily => ({ id: loc.id, daily })))
    )
  ]);

  const weatherData = {};
  const seasonalData = {};
  const failed = [];

  forecastResults.forEach((r, i) => {
    if (r.status === 'fulfilled' && r.value && r.value.daily) {
      weatherData[r.value.id] = { daily: r.value.daily, hourly: r.value.hourly };
    } else {
      failed.push(locations[i].name);
      console.error(`無法載入 ${locations[i].name}`, r.reason);
    }
  });

  seasonalResults.forEach(r => {
    if (r.status === 'fulfilled' && r.value && r.value.daily) {
      seasonalData[r.value.id] = r.value.daily;
    }
  });

  renderTable(weatherData, seasonalData);

  if (failed.length === 0) {
    setStatus('已載入最新資料', 'ok');
  } else if (failed.length < locations.length) {
    setStatus(`${failed.join('、')} 載入失敗`, 'error');
  } else {
    setStatus('載入失敗，請重試', 'error');
  }

  lastUpdatedEl.textContent = fullDateTimeLabel();
  setLoading(false);
  isFetching = false;
}

/* =========================================================
   8. 渲染表格
   ========================================================= */
function buildSlotHTML(slots) {
  return slots.map(s => {
    const tip = `${s.label}：${s.level.label}（${s.score}分）${s.reasons.length ? '｜' + s.reasons.join('、') : ''}`;
    return `<span class="slot ${s.level.cls}" title="${tip}">${s.label}</span>`;
  }).join('');
}

function renderTable(weatherData, seasonalData) {
  const tbody = document.querySelector('#weatherTable tbody');
  tbody.innerHTML = '';
  const today = todayStr();

  tripDates.forEach(dateStr => {
    const tr = document.createElement('tr');
    if (dateStr === today) tr.classList.add('today');

    /* ---- 日期欄 ---- */
    const dateTd = document.createElement('td');
    dateTd.className = 'date-col';
    const dt = new Date(dateStr + 'T00:00:00');
    const mmdd = dateStr.slice(5).replace('-', '/');
    const dow = isNaN(dt) ? '' : WEEKDAYS[dt.getDay()];
    const plans = itinerary[dateStr] || [];
    const planStar = plans.length > 0 ? ' <span style="color:#f5b400;">⭐</span>' : '';
    dateTd.innerHTML = `${mmdd}${planStar}<div class="dow">週${dow}${dateStr === today ? ' · 今天' : ''}</div>`;
    tr.appendChild(dateTd);

    /* ---- 各地天氣欄 ---- */
    locations.forEach(loc => {
      const td = document.createElement('td');

      const isPlan = isPlanFor(dateStr, loc.id);
      if (isPlan) {
        td.classList.add('plan-cell');
        const star = document.createElement('span');
        star.className = 'plan-star';
        star.textContent = '⭐';
        td.appendChild(star);
      }

      const entry = weatherData[loc.id];
      const seasonal = seasonalData[loc.id];

      if (!entry || !entry.daily || !Array.isArray(entry.daily.time)) {
        const pending = document.createElement('span');
        pending.className = 'pending';
        pending.innerHTML = '—<small>載入失敗</small>';
        td.appendChild(pending);
        tr.appendChild(td);
        return;
      }

      const { daily, hourly } = entry;
      const idx = daily.time.indexOf(dateStr);

      /* ====== 1. 標準預報 ====== */
      if (idx !== -1) {
        const maxT  = Math.round(daily.temperature_2m_max[idx]);
        const minT  = Math.round(daily.temperature_2m_min[idx]);
        const code  = daily.weather_code[idx];
        const icon  = getWeatherIcon(code);
        const text  = getWeatherText(code);
        const slots = analyzeDaySlots(hourly, dateStr, true);
        const sunrise = formatTime(daily.sunrise?.[idx]);
        const sunset  = formatTime(daily.sunset?.[idx]);

        const box = document.createElement('div');
        box.className = 'cell-box';
        box.innerHTML = `
          <span class="wicon" title="${text}">${icon}</span>
          <span class="temp">${maxT}° / ${minT}°</span>
          <div class="slots">${buildSlotHTML(slots)}</div>
          <div class="sun">🌅${sunrise} 🌇${sunset}</div>
        `;
        td.appendChild(box);
        td.title = `${loc.name}｜${dateStr}${isPlan ? '（⭐ 行程）' : ''}\n${text} · ${maxT}° / ${minT}°C`;
        tr.appendChild(td);
        return;
      }

      /* ====== 2. 季節（長期）預報 ====== */
      if (seasonal && Array.isArray(seasonal.time)) {
        const sIdx = seasonal.time.indexOf(dateStr);
        if (sIdx !== -1) {
          const maxT  = Math.round(seasonal.temperature_2m_max[sIdx]);
          const minT  = Math.round(seasonal.temperature_2m_min[sIdx]);
          const code  = seasonal.weather_code?.[sIdx];
          const precip = seasonal.precipitation_sum?.[sIdx] ?? 0;
          const icon  = getWeatherIcon(code);
          const text  = getWeatherText(code);

          const { score } = scoreOutdoor({
            weather_code: code,
            precipitation: precip,
            temperature_2m: (maxT + minT) / 2
          });
          const level = getLevel(score);

          const box = document.createElement('div');
          box.className = 'cell-box';
          box.innerHTML = `
            <span class="wicon" title="${text}">${icon}</span>
            <span class="temp">${maxT}° / ${minT}°</span>
            <div class="slots">
              <span class="slot ${level.cls}" title="長期預報趨勢：${level.label}（${score}分）">${level.label}</span>
            </div>
            <span class="tag tag-seasonal">🔮 長期預報</span>
          `;
          td.appendChild(box);
          td.title = `${loc.name}｜${dateStr}${isPlan ? '（⭐ 行程）' : ''}\n🔮 長期預報（趨勢參考）\n${text} · ${maxT}° / ${minT}°C\n降水量 ${precip} mm`;
          tr.appendChild(td);
          return;
        }
      }

      /* ====== 3. 歷史估計 ====== */
      const pending = document.createElement('span');
      pending.className = 'pending';
      pending.innerHTML = '🔄<small>查詢中…</small>';
      td.appendChild(pending);
      tr.appendChild(td);

      const currentTd = td;
      const planFlag = isPlan;

      fetchHistoricalAverage(loc, dateStr).then(avg => {
        if (avg) {
          const icon = getWeatherIcon(avg.code);
          const text = getWeatherText(avg.code);
          const sunrise = formatTime(avg.sunrise);
          const sunset  = formatTime(avg.sunset);

          currentTd.querySelectorAll('.cell-box, .pending').forEach(el => el.remove());

          const box = document.createElement('div');
          box.className = 'cell-box';
          box.innerHTML = `
            <span class="wicon" title="${text}">${icon}</span>
            <span class="temp">${avg.max}° / ${avg.min}°</span>
            <div class="slots">${buildSlotHTML(avg.slots)}</div>
            <div class="sun">🌅${sunrise} 🌇${sunset}</div>
            <span class="tag tag-estimate">📊 估計</span>
          `;
          currentTd.appendChild(box);
          currentTd.title =
            `${loc.name}｜${dateStr}${planFlag ? '（⭐ 行程）' : ''}\n` +
            `📊 過去三年同日平均\n${text} · ${avg.max}° / ${avg.min}°C\n平均降水量 ${avg.rain} mm`;
        } else {
          currentTd.querySelectorAll('.pending').forEach(el => el.remove());
          const errSpan = document.createElement('span');
          errSpan.className = 'pending';
          errSpan.innerHTML = '無資料';
          currentTd.appendChild(errSpan);
        }
      });
    });

    tbody.appendChild(tr);
  });
}

/* =========================================================
   9. 啟動
   ========================================================= */
// 只在頁面載入時執行一次
fetchAllWeather();

// 手動重新載入按鈕
btn.addEventListener('click', fetchAllWeather);
</script>


const tripDates = [
  "2026-10-16", "2026-10-17", "2026-10-18", "2026-10-19",
  "2026-10-20", "2026-10-21", "2026-10-22", "2026-10-23",
  "2026-10-24", "2026-10-25", "2026-10-26", "2026-10-27"
];

/* =========================================================
   ★★★ 行程計劃表 ★★★
   ========================================================= */
const itinerary = {
  '2026-10-16': ['tbilisi'],
  '2026-10-17': ['tbilisi'],
  '2026-10-18': ['sighnaghi'],
  '2026-10-19': ['kazbegi'],
  '2026-10-20': ['juta'],
  '2026-10-21': ['kutaisi'],
  '2026-10-22': ['mestia'],
  '2026-10-23': ['ushguli'],
  '2026-10-24': ['zugdidi'],
  '2026-10-25': ['dubai'],
  '2026-10-26': ['dubai'],
  '2026-10-27': ['dubai']
};

const FORECAST_DAYS = 16;
const SEASONAL_DAYS = 46;

const TIME_SLOTS = [
  { id: 'morning',   label: '早', start: 6,  end: 12 },
  { id: 'afternoon', label: '午', start: 12, end: 18 },
  { id: 'evening',   label: '晚', start: 18, end: 24 }
];

const historicalCache = {};
const seasonalCache = {};

/* =========================================================
   2. 六級適宜度評分系統
   ========================================================= */
const LEVELS = [
  { min: 90, key: 'excellent', cls: 'lv-excellent', label: '極佳' },
  { min: 75, key: 'great',     cls: 'lv-great',     label: '適合' },
  { min: 60, key: 'good',      cls: 'lv-good',      label: '尚可' },
  { min: 45, key: 'fair',      cls: 'lv-fair',      label: '普通' },
  { min: 30, key: 'poor',      cls: 'lv-poor',      label: '不佳' },
  { min: 0,  key: 'bad',       cls: 'lv-bad',       label: '不宜' }
];

function getLevel(score) {
  for (const lv of LEVELS) {
    if (score >= lv.min) return lv;
  }
  return LEVELS[LEVELS.length - 1];
}

function scoreOutdoor(hourData) {
  let score = 100;
  const reasons = [];

  const code = hourData.weather_code;
  const precip = hourData.precipitation || 0;
  const prob = hourData.precipitation_probability;
  const temp = hourData.temperature_2m;
  const wind = hourData.wind_speed_10m;

  if (typeof code === 'number') {
    if (code >= 96) { score -= 85; reasons.push('雷暴冰雹'); }
    else if (code === 95) { score -= 75; reasons.push('雷暴'); }
    else if (code >= 85 && code <= 86) { score -= 60; reasons.push('強陣雪'); }
    else if (code >= 75 && code <= 77) { score -= 60; reasons.push('大雪'); }
    else if (code >= 71 && code <= 73) { score -= 50; reasons.push('降雪'); }
    else if (code >= 65 && code <= 67) { score -= 55; reasons.push('凍雨'); }
    else if (code >= 63 && code <= 64) { score -= 50; reasons.push('中雨'); }
    else if (code === 61 || code === 62) { score -= 45; reasons.push('降雨'); }
    else if (code === 80) { score -= 35; reasons.push('小陣雨'); }
    else if (code === 81) { score -= 45; reasons.push('陣雨'); }
    else if (code === 82) { score -= 55; reasons.push('強陣雨'); }
    else if (code >= 51 && code <= 55) { score -= 25; reasons.push('毛毛雨'); }
    else if (code === 45 || code === 48) { score -= 20; reasons.push('有霧'); }
    else if (code === 3) { score -= 8; reasons.push('陰天'); }
    else if (code === 2) { score -= 3; }
  }

  if (precip > 8) { score -= 25; reasons.push('大雨量'); }
  else if (precip > 4) { score -= 18; }
  else if (precip > 2) { score -= 12; }
  else if (precip > 0.5) { score -= 6; }

  if (typeof prob === 'number') {
    if (prob >= 85) { score -= 18; reasons.push('極高降雨機率'); }
    else if (prob >= 70) { score -= 12; reasons.push('高降雨機率'); }
    else if (prob >= 55) { score -= 7; }
    else if (prob >= 40) { score -= 3; }
  }

  if (typeof temp === 'number') {
    if (temp < -15) { score -= 55; reasons.push('極寒'); }
    else if (temp < -8) { score -= 45; reasons.push('嚴寒'); }
    else if (temp < -2) { score -= 32; reasons.push('寒冷'); }
    else if (temp < 3) { score -= 18; reasons.push('偏冷'); }
    else if (temp < 8) { score -= 6; }
    else if (temp > 42) { score -= 55; reasons.push('極端酷熱'); }
    else if (temp > 38) { score -= 42; reasons.push('酷熱'); }
    else if (temp > 34) { score -= 28; reasons.push('炎熱'); }
    else if (temp > 30) { score -= 14; reasons.push('偏熱'); }
    else if (temp > 26) { score -= 5; }
  }

  if (typeof wind === 'number') {
    if (wind > 70) { score -= 35; reasons.push('暴風'); }
    else if (wind > 55) { score -= 25; reasons.push('強風'); }
    else if (wind > 42) { score -= 15; reasons.push('大風'); }
    else if (wind > 30) { score -= 6; }
  }

  return { score: Math.max(0, Math.min(100, score)), reasons };
}

function analyzeDaySlots(hourly, dateStr, hasProb) {
  if (!hourly || !Array.isArray(hourly.time)) return null;

  return TIME_SLOTS.map(slot => {
    const indices = [];
    hourly.time.forEach((t, i) => {
      if (t && t.startsWith(dateStr)) {
        const hour = parseInt(t.slice(11, 13), 10);
        if (hour >= slot.start && hour < slot.end) indices.push(i);
      }
    });

    if (indices.length === 0) {
      return { ...slot, score: 80, level: getLevel(80), reasons: [] };
    }

    let totalScore = 0;
    const reasonSet = new Set();
    let hasAnyData = false;

    indices.forEach(i => {
      const hourData = {
        temperature_2m: hourly.temperature_2m?.[i],
        precipitation: hourly.precipitation?.[i],
        precipitation_probability: hourly.precipitation_probability?.[i],
        weather_code: hourly.weather_code?.[i],
        wind_speed_10m: hourly.wind_speed_10m?.[i]
      };
      if (hourData.weather_code !== undefined || hourData.temperature_2m !== undefined) {
        hasAnyData = true;
        const { score, reasons } = scoreOutdoor(hourData);
        totalScore += score;
        reasons.forEach(r => reasonSet.add(r));
      }
    });

    if (!hasAnyData) {
      return { ...slot, score: 80, level: getLevel(80), reasons: [] };
    }

    const avgScore = Math.round(totalScore / indices.length);
    return {
      ...slot,
      score: avgScore,
      level: getLevel(avgScore),
      reasons: Array.from(reasonSet)
    };
  });
}

